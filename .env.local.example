# Crie um projeto gratuito em https://supabase.com, depois vá em
# Project Settings -> API e copie os dois valores abaixo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: só necessário pro assistente de IA (anamnese, plano gerado e
# chat). Crie uma conta em https://console.anthropic.com, adicione crédito
# e gere uma chave em Settings -> API Keys. Sem isso, o resto do app
# funciona normal — só a IA fica desativada.
ANTHROPIC_API_KEY=
