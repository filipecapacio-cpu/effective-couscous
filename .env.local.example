# Crie um projeto gratuito em https://supabase.com, depois vá em
# Project Settings -> API e copie os dois valores abaixo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: só necessário pro assistente de IA (anamnese, plano gerado e
# chat). Crie uma conta em https://console.anthropic.com, adicione crédito
# e gere uma chave em Settings -> API Keys. Sem isso, o resto do app
# funciona normal — só a IA fica desativada.
ANTHROPIC_API_KEY=

# Opcional: só necessário pra conectar wearables (Garmin, via Terra API).
# ATENÇÃO: a Terra NÃO tem plano gratuito de verdade - planos pagos a
# partir de ~US$400/mês (confira em tryterra.co/pricing). Só vale a pena
# com receita que já cubra esse custo. TERRA_SIGNING_SECRET é o secret que
# a Terra mostra ao configurar seu webhook — sem ele o endpoint recusa
# qualquer chamada. Sem essas três, o resto do app funciona normal — só a
# seção "Wearable" do Perfil fica desativada.
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_SIGNING_SECRET=
